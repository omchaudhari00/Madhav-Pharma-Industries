# Copy this file to .env and fill in your own values.
#   cp .env.example .env

# --- PostgreSQL ---------------------------------------------------------
# Django reads these in backend/settings.py; the password never goes in code.
DB_NAME=madhav_pharma
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Django -------------------------------------------------------------
# DEBUG=True is required for local development: with DEBUG=False, settings.py
# insists on a real SECRET_KEY and refuses to start without one.
DEBUG=True

# Set this in production (any long random string). Leave blank locally.
SECRET_KEY=

# Optional: managed hosts supply one connection string instead of the DB_* vars
# above. When present it takes priority.
# DATABASE_URL=postgres://user:password@host:5432/dbname
